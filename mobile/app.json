{
  "expo": {
    "name": "Oro",
    "slug": "oro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.asata.oro"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.asata.oro"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "Oro uses your photos to send them in a conversation.",
          "cameraPermission": "Oro uses the camera to take a photo for a conversation."
        }
      ]
    ],
    "scheme": "oro",
    "experiments": {
      "typedRoutes": true
    }
  }
}
